PORT=3000
# Configure these values in Render Dashboard > Environment.
SMTP_HOST=your-company-smtp-relay.example.com
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS (often port 587).
SMTP_SECURE=false
# Optional: leave BOTH SMTP_USER and SMTP_PASS unset if your authorized relay uses IP allowlisting/no SMTP AUTH.
SMTP_USER=
SMTP_PASS=
# Must be an approved sender address for your SMTP relay.
MAIL_FROM=application-notifications@relianceegypt.com
HR_RECIPIENT=careers@relianceegypt.com
